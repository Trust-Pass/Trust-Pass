{
  "name": "@trustpass/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/scripts/seed.ts",
    "keys:rewrap": "tsx src/scripts/rewrap-keys.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@ip-location-db/dbip-country-mmdb": "^2.3.2026060120",
    "@prisma/client": "6.19.3",
    "@trustpass/shared": "workspace:*",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "maxmind": "^5.1.0",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "prisma": "6.19.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
