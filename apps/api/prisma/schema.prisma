// TrustPass database schema.
// Hand-written SQL in the migrations adds CHECK constraints and the
// append-only triggers on access_logs and security_events.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  individual
  organization
}

enum UserRole {
  user
  admin
}

enum AccountStatus {
  active
  suspended
}

enum OrganizationType {
  company
  university
  government
  other
}

enum OrgRole {
  owner
  admin
  member
}

enum DocumentCategory {
  university_certificate
  enrollment_certificate
  professional_certificate
  employment_document
  identity_document
  other
}

enum DocumentKind {
  file
  credential
}

enum ClaimSource {
  issuer
  self_declared
}

enum IssuerStatus {
  trusted
  revoked
}

enum RecipientType {
  anyone
  organization
}

enum VerificationResult {
  verified
  invalid
  unverified
}

enum VerificationMethod {
  file
  presentation
  share_link
}

enum AccessOutcome {
  granted
  denied_revoked
  denied_expired
  denied_recipient
  denied_country
}

enum AccessResource {
  details
  file
  download
}

enum Severity {
  info
  warning
  high
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  accountType  AccountType   @map("account_type")
  role         UserRole      @default(user)
  status       AccountStatus @default(active)
  failedLogins Int           @default(0) @map("failed_logins")
  lockedUntil  DateTime?     @map("locked_until") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  memberships         OrganizationMember[]
  documents           Document[]
  sharingLinks        SharingLink[]
  notifications       Notification[]

  @@map("users")
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash")
  csrfToken       String   @map("csrf_token")
  userAgentFamily String?  @map("user_agent_family")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  type      OrganizationType
  status    AccountStatus    @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  members       OrganizationMember[]
  receivedLinks SharingLink[]

  @@index([name])
  @@map("organizations")
}

model OrganizationMember {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(member)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Document {
  // The id is generated by the application before encryption, because it is
  // bound into the AES-GCM additional authenticated data.
  id               String           @id @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  // Plain columns are legacy (E3): new rows leave them empty and use the *Encrypted columns.
  title            String?
  titleEncrypted   Bytes?           @map("title_encrypted")
  category         DocumentCategory
  kind             DocumentKind
  mimeType         String           @map("mime_type")
  sizeBytes        Int              @map("size_bytes")
  storageKey       String           @unique @map("storage_key")
  plaintextSha256  String?          @map("plaintext_sha256")
  sha256Encrypted  Bytes?           @map("sha256_encrypted")
  encIv            Bytes            @map("enc_iv")
  encTag           Bytes            @map("enc_tag")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)

  owner      User            @relation(fields: [ownerId], references: [id])
  key        DocumentKey?
  claims     DocumentClaim[]
  credential Credential?
  links      SharingLink[]
  redactedPages RedactedPage[]

  @@index([ownerId, createdAt])
  @@map("documents")
}

model DocumentKey {
  documentId String   @id @map("document_id") @db.Uuid
  wrappedDek Bytes    @map("wrapped_dek")
  wrapIv     Bytes    @map("wrap_iv")
  wrapTag    Bytes    @map("wrap_tag")
  kekVersion Int      @map("kek_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_keys")
}

model DocumentClaim {
  id                  String      @id @default(uuid()) @db.Uuid
  documentId          String      @map("document_id") @db.Uuid
  claimKey            String      @map("claim_key")
  label               String?
  labelEncrypted      Bytes?      @map("label_encrypted")
  // iv | tag | ciphertext, sealed with the document's data key
  valueEncrypted      Bytes       @map("value_encrypted")
  // SD-JWT disclosure for issuer claims, sealed the same way
  disclosureEncrypted Bytes?      @map("disclosure_encrypted")
  source              ClaimSource
  position            Int         @default(0)

  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  permissions SharingPermission[]

  @@unique([documentId, claimKey])
  @@map("document_claims")
}

model Issuer {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  identifier   String       @unique
  kid          String       @unique
  publicKeyJwk Json         @map("public_key_jwk")
  status       IssuerStatus @default(trusted)
  isSimulated  Boolean      @default(false) @map("is_simulated")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  credentials Credential[]

  @@map("issuers")
}

model Credential {
  id                  String   @id @db.Uuid
  documentId          String   @unique @map("document_id") @db.Uuid
  issuerId            String   @map("issuer_id") @db.Uuid
  format              String   @default("sd-jwt")
  credentialEncrypted Bytes    @map("credential_encrypted")
  documentHash        String   @map("document_hash")
  issuedAt            DateTime @map("issued_at") @db.Timestamptz(3)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  issuer   Issuer   @relation(fields: [issuerId], references: [id])

  @@index([documentHash])
  @@index([issuerId])
  @@map("credentials")
}

model SharingLink {
  id             String        @id @default(uuid()) @db.Uuid
  documentId     String        @map("document_id") @db.Uuid
  ownerId        String        @map("owner_id") @db.Uuid
  tokenHash      String        @unique @map("token_hash")
  tokenEncrypted Bytes         @map("token_encrypted")
  recipientType  RecipientType @map("recipient_type")
  recipientOrgId String?       @map("recipient_org_id") @db.Uuid
  recipientLabel          String?       @map("recipient_label")
  recipientLabelEncrypted Bytes?        @map("recipient_label_encrypted")
  includeFile    Boolean       @map("include_file")
  /// Recipient may download a separate watermarked PDF (requires includeFile).
  allowDownload  Boolean       @default(false) @map("allow_download")
  /// What file the recipient gets when includeFile: "original" (null = original) or "redacted".
  fileMode       String?       @map("file_mode")
  /// Recipient copies carry a watermark (owner's choice; true for every link made before the option).
  watermarkEnabled   Boolean   @default(true) @map("watermark_enabled")
  /// Watermark look (style, colour, strength, stamp text) sealed with the document key. Null = standard.
  watermarkEncrypted Bytes?    @map("watermark_encrypted")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  lastAccessedAt DateTime?     @map("last_accessed_at") @db.Timestamptz(3)
  viewCount      Int           @default(0) @map("view_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  document     Document            @relation(fields: [documentId], references: [id])
  owner        User                @relation(fields: [ownerId], references: [id])
  recipientOrg Organization?       @relation(fields: [recipientOrgId], references: [id])
  permissions  SharingPermission[]
  countries    AllowedCountry[]
  redactedPages RedactedPage[]

  @@index([ownerId, createdAt])
  @@index([documentId])
  @@index([recipientOrgId])
  @@map("sharing_links")
}

/// A page of a link's redacted copy: image with black boxes burned in, AES-256-GCM with the document key.
model RedactedPage {
  id         String   @id @default(uuid()) @db.Uuid
  linkId     String   @map("link_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  pageIndex  Int      @map("page_index")
  storageKey String   @map("storage_key")
  encIv      Bytes    @map("enc_iv")
  encTag     Bytes    @map("enc_tag")
  width      Int
  height     Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  link     SharingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([linkId, pageIndex])
  @@index([documentId])
  @@map("redacted_pages")
}

model SharingPermission {
  linkId  String @map("link_id") @db.Uuid
  claimId String @map("claim_id") @db.Uuid

  link  SharingLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  claim DocumentClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([linkId, claimId])
  @@index([claimId])
  @@map("sharing_permissions")
}

model AllowedCountry {
  linkId      String @map("link_id") @db.Uuid
  countryCode String @map("country_code") @db.Char(2)

  link SharingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, countryCode])
  @@map("allowed_countries")
}

model VerificationRecord {
  id               String             @id @default(uuid()) @db.Uuid
  result           VerificationResult
  method           VerificationMethod
  reason           String
  checks           Json
  documentId       String?            @map("document_id") @db.Uuid
  credentialId     String?            @map("credential_id") @db.Uuid
  linkId           String?            @map("link_id") @db.Uuid
  issuerId         String?            @map("issuer_id") @db.Uuid
  verifiedByUserId String?            @map("verified_by_user_id") @db.Uuid
  verifiedByOrgId  String?            @map("verified_by_org_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([verifiedByUserId, createdAt])
  @@index([verifiedByOrgId, createdAt])
  @@index([documentId])
  @@map("verification_records")
}

model AccessLog {
  id              BigInt         @id @default(autoincrement())
  linkId          String         @map("link_id") @db.Uuid
  documentId      String         @map("document_id") @db.Uuid
  ownerId         String         @map("owner_id") @db.Uuid
  resource        AccessResource
  outcome         AccessOutcome
  countryCode     String?        @map("country_code") @db.Char(2)
  ipHmac          String?        @map("ip_hmac")
  userAgentFamily String?        @map("user_agent_family")
  accessorUserId  String?        @map("accessor_user_id") @db.Uuid
  accessorOrgId   String?        @map("accessor_org_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@index([linkId, createdAt])
  @@index([documentId, createdAt])
  @@map("access_logs")
}

model SecurityEvent {
  id          BigInt   @id @default(autoincrement())
  userId      String?  @map("user_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventType   String   @map("event_type")
  severity    Severity @default(info)
  documentId  String?  @map("document_id") @db.Uuid
  linkId      String?  @map("link_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@map("security_events")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  linkId     String?   @map("link_id") @db.Uuid
  documentId String?   @map("document_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// Ciphertext store used by the "database" storage driver. It holds only
// AES-256-GCM ciphertext; keys live in document_keys and the master key in
// the environment.
model StoredObject {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stored_objects")
}

/// Key-encryption keys (KEKs) and link-token keys, stored only encrypted by a KMS (E2).
/// Rows can never be deleted or altered except for their status (database trigger):
/// losing a row makes every document wrapped by it unreadable.
model KeyEncryptionKey {
  purpose      String
  version      Int
  provider     String
  kmsKeyName   String    @map("kms_key_name")
  encryptedKey Bytes     @map("encrypted_key")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz(3)

  @@id([purpose, version])
  @@map("key_encryption_keys")
}
