# Copy to .env for local development. Never commit real secrets.
# Generate random secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=3000
# Public URL of the web app (http://localhost:5173 with the Vite dev server).
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://trustpass:trustpass_dev@localhost:5432/trustpass_dev

# Where the key-encryption keys come from (see docs/security.md, "Key management"):
#   fake-kms - local stand-in for a KMS: a random root key in FAKE_KMS_KEY_FILE (development only)
#   gcp-kms  - Google Cloud KMS (production): set GCP_KMS_KEY_NAME and GCP_SERVICE_ACCOUNT_JSON
#   env      - legacy: keys derived from MASTER_KEY, which sits next to the app
KEY_PROVIDER=fake-kms
FAKE_KMS_KEY_FILE=./data/dev-fake-kms.key
# The fake KMS only runs against a local database. For a database in a local container, name its host:
# FAKE_KMS_ALLOW_DATABASE_HOST=postgres
# How often a running server checks for a newly rotated key (seconds).
KEY_REFRESH_SECONDS=30
# GCP_KMS_KEY_NAME=projects/<project>/locations/europe-west3/keyRings/trustpass/cryptoKeys/trustpass-root-kek
# GCP_SERVICE_ACCOUNT_JSON=<service account key JSON, or the same base64-encoded>

# Legacy master key (KEY_PROVIDER=env, or while moving existing data to a KMS with keys:rewrap).
# MASTER_KEY=replace-with-32-plus-random-characters
# MASTER_KEY_VERSION=1
# During rotation, keep old keys here: "1:<old secret>,2:<older secret>"
# PREVIOUS_MASTER_KEYS=
# One-off maintenance after the server starts, for hosts without a shell (e.g. Render free).
# Allowed: encrypt-metadata, rewrap (comma-separated). Remove it again once Admin > Health is green.
# STARTUP_MAINTENANCE=
# Key for the keyed hash of visitor IPs (raw IPs are never stored).
IP_HASH_SECRET=replace-with-32-plus-random-characters
# Seed of the simulated university's Ed25519 signing key.
ISSUER_SIGNING_SEED=replace-with-32-plus-random-characters

# local | database
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage

# mmdb (real IP lookup, offline) | simulated (development and tests only; refused in production)
GEO_PROVIDER=simulated
GEO_SIMULATED_DEFAULT=SA
# GEO_SIMULATED_MAP=203.0.113.5=US,198.51.100.7=AE
# false when nothing sits in front of the API; behind a platform load balancer either the number of
# proxy hops, or the private ranges its proxies use, e.g. loopback,linklocal,uniquelocal,100.64.0.0/10
TRUST_PROXY=false
# Behind Cloudflare (including Render's onrender.com): cf-connecting-ip. Only a header your edge overwrites.
# CLIENT_IP_HEADER=cf-connecting-ip

# console (development) | smtp | none
MAIL_TRANSPORT=console
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=TrustPass <no-reply@trustpass.local>

MAX_UPLOAD_MB=10
LOG_LEVEL=info

# Created (or promoted) by `pnpm db:seed`.
ADMIN_EMAIL=admin@trustpass.local
ADMIN_PASSWORD=replace-with-a-12-plus-character-password
